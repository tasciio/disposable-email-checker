{
  "name": "disposable-email-checker",
  "version": "1.0.0",
  "private": true,
  "description": "A free, public disposable-email domain checker for Cloudflare Workers.",
  "license": "MIT",
  "keywords": [
    "cloudflare-workers",
    "disposable-email",
    "email-validation",
    "public-api"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run deploy:dry-run",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "deploy:dry-run": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:data": "vitest run test/domain-list.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.36.0"
  }
}
