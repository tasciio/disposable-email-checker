{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "disposable-email-checker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "minify": true,
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    // Use "*" for a public browser API, or a comma-separated origin allowlist.
    "ALLOWED_ORIGINS": "*"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      // This must be a positive integer string unique within your Cloudflare account.
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ]
}

